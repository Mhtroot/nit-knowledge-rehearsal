# Database connection
DATABASE_URL="mysql://root:root@127.0.0.1:3306/service_base"
DB_HOST=
DB_PORT=
DB="service_base"
DB_USER=
DB_PASS=

# Application port (local dev; container defaults to 4567)
PORT=4567

# Security & JWT Secret
JWT_SECRET="your-secret-key"

# Admin initial credentials
ADMIN_USER=
ADMIN_PASS=

# Swagger UI basic authentication credentials
SWAGG_USER=
SWAGG_PASS=

# CORS Origins (comma-separated, default is *)
# e.g.: CORS_ORIGIN="https://sciencenight.nit.ac.ir,https://nit.ac.ir"
CORS_ORIGIN="*"

# Docker Compose overlays
# Uncomment for production deployment with HTTPS enabled:
# COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
