generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id    String @id @default(uuid())
  username  String
  password  String
}

model User {
  id                Int     @id @default(autoincrement())
  ssn               String     @unique
  fullName          String
  phone             String  @unique
}
