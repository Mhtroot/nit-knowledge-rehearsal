generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id        String @id @default(uuid())
  username  String
  password  String
}

model User {
  id                Int     @id @default(autoincrement())
  ssn               String  @unique
  fullName          String
  phone             String  @unique
  childCount        Int     @default(0)
  teenageCount      Int     @default(0)
  adultCount        Int     @default(0)
}

model News {
  id          Int         @id @default(autoincrement())
  title       String
  description String      @db.Text
  images      NewsImage[]
}

model NewsImage {
  id     Int    @id @default(autoincrement())
  path   String
  newsId Int
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
}
